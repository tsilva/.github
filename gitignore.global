# Standard gitignore rules for tsilva organization
# Used by scripts/sync-gitignore.sh

# Claude Code
.claude/*.local.json
.claude/*.local.json.bak
.claude-sandbox.json
.mcp.json

# Secrets and credentials
.env
.env.*
!.env.example
!.env.*.example
.env.*.local
.env.local
*.pem
*.key
*.p12
*.pfx
*.gpg
*.secret
*-credentials.json
service-account*.json
credentials.json
secrets.json
.secrets/
.aws/
.ssh/
config.local.*

# macOS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*.code-workspace

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Node.js
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
dist/
build/

# Logs
logs/
*.log
